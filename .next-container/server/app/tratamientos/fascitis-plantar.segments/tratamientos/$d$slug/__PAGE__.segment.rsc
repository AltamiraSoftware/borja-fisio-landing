30:["$","div","¿Puedo seguir caminando o corriendo con fascitis plantar?",{"className":"rounded-[28px] border text-center transition-[transform,border-color,box-shadow,background-color] duration-300 ease-out border-[#8eb9ca] bg-white/[0.82] text-[var(--color-text)] shadow-[0_14px_38px_rgba(15,83,102,0.13),0_2px_8px_rgba(15,83,102,0.07)] backdrop-blur-xl hover:-translate-y-1.5 hover:border-[#1d7898] hover:shadow-[0_24px_52px_rgba(15,83,102,0.23),0_0_0_3px_rgba(46,196,198,0.11)] focus-within:border-[#1d7898] focus-within:shadow-[0_24px_52px_rgba(15,83,102,0.23),0_0_0_3px_rgba(46,196,198,0.11)] motion-reduce:hover:translate-y-0 overflow-hidden","children":["$","details",null,{"className":"group","children":[["$","summary",null,{"className":"cursor-pointer px-6 py-5 font-semibold text-[#073B4C]","children":"¿Puedo seguir caminando o corriendo con fascitis plantar?"}],["$","p",null,{"className":"border-t border-[#a8cbd7] px-6 py-5 leading-7 text-[var(--color-muted)]","children":"La actividad se ajusta a tus síntomas y a la respuesta al esfuerzo. Puede ser necesario reducir temporalmente distancias o intensidad y combinarlo con ejercicio específico para recuperar tolerancia."}]]}]}]
31:["$","div","¿Cuántas sesiones de fisioterapia voy a necesitar?",{"className":"rounded-[28px] border text-center transition-[transform,border-color,box-shadow,background-color] duration-300 ease-out border-[#8eb9ca] bg-white/[0.82] text-[var(--color-text)] shadow-[0_14px_38px_rgba(15,83,102,0.13),0_2px_8px_rgba(15,83,102,0.07)] backdrop-blur-xl hover:-translate-y-1.5 hover:border-[#1d7898] hover:shadow-[0_24px_52px_rgba(15,83,102,0.23),0_0_0_3px_rgba(46,196,198,0.11)] focus-within:border-[#1d7898] focus-within:shadow-[0_24px_52px_rgba(15,83,102,0.23),0_0_0_3px_rgba(46,196,198,0.11)] motion-reduce:hover:translate-y-0 overflow-hidden","children":["$","details",null,{"className":"group","children":[["$","summary",null,{"className":"cursor-pointer px-6 py-5 font-semibold text-[#073B4C]","children":"¿Cuántas sesiones de fisioterapia voy a necesitar?"}],["$","p",null,{"className":"border-t border-[#a8cbd7] px-6 py-5 leading-7 text-[var(--color-muted)]","children":"Depende del problema, del tiempo de evolución y de los objetivos que quieras recuperar. Tras la valoración se propone un plan y se revisa según los cambios en dolor, movilidad y capacidad para realizar tus actividades."}]]}]}]
