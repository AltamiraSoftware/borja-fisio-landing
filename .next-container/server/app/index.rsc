5:T1b69,[{"@context":"https://schema.org","@type":"Person","@id":"https://tufisioadomicilio.vercel.app/#borja-estarellas","name":"Borja Estarellas Botín","jobTitle":"Fisioterapeuta","url":"https://tufisioadomicilio.vercel.app","worksFor":{"@id":"https://tufisioadomicilio.vercel.app/#organization"},"knowsAbout":["Fisioterapia musculoesquelética","Fisioterapia deportiva","Terapia manual","Ejercicio terapéutico","Dolor lumbar","Dolor cervical","Tendinopatías","Esguinces","Fascitis plantar","Ecografía musculoesquelética"]},{"@context":"https://schema.org","@type":"MedicalBusiness","@id":"https://tufisioadomicilio.vercel.app/#organization","name":"Borja Estarellas Botín","url":"https://tufisioadomicilio.vercel.app","description":"Fisioterapia en Madrid para dolor, lesiones deportivas y recuperación funcional. Consulta en Arganzuela y atención a domicilio.","image":"https://tufisioadomicilio.vercel.app/borja.png","address":{"@type":"PostalAddress","streetAddress":"Calle de Rafael de Riego, 11","addressLocality":"Madrid","addressRegion":"Madrid","postalCode":"28045","addressCountry":"ES"},"hasMap":"https://www.google.com/maps/search/?api=1&query=Calle+de+Rafael+de+Riego+11%2C+28045+Madrid","areaServed":{"@type":"City","name":"Madrid","sameAs":"https://en.wikipedia.org/wiki/Madrid"},"sameAs":[]},{"@context":"https://schema.org","@type":"Service","@id":"https://tufisioadomicilio.vercel.app/#fisioterapia-madrid","name":"Fisioterapia en Madrid","serviceType":"Fisioterapia","provider":{"@id":"https://tufisioadomicilio.vercel.app/#organization"},"areaServed":[{"@type":"City","name":"Madrid"},{"@type":"Place","name":"Palos de la Frontera, Arganzuela"}],"offers":[{"@type":"Offer","name":"Primera sesión en consulta","price":"50","priceCurrency":"EUR","url":"https://tufisioadomicilio.vercel.app/tarifas"},{"@type":"Offer","name":"Primera sesión a domicilio","price":"60","priceCurrency":"EUR","url":"https://tufisioadomicilio.vercel.app/tarifas"}],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Tratamientos de fisioterapia","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Fisioterapia deportiva","description":"Recuperación de lesiones musculares, tendinosas y articulares con valoración funcional, ecografía si procede y vuelta progresiva al deporte."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Ecografía musculoesquelética","description":"Valoración con ecógrafo de músculos, tendones y otros tejidos blandos para complementar la exploración clínica y orientar la fisioterapia."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Cervicalgia","description":"Tratamiento del dolor cervical, la rigidez y las molestias de cuello y trapecios con terapia manual y ejercicio terapéutico."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Lumbalgia y ciática","description":"Valoración del dolor de la zona baja de la espalda y de los síntomas hacia la pierna, con ejercicio y recuperación progresiva de la actividad."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Tendinopatías","description":"Tratamiento del dolor de tendón en hombro, codo, rodilla o Aquiles. Valoración clínica, ecografía cuando está indicada y ejercicio progresivo."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Contracturas","description":"Abordaje de contracturas, sobrecargas y dolor muscular con valoración del movimiento, terapia manual y ejercicio adaptado."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Esguinces","description":"Recuperación de movilidad, fuerza y estabilidad tras un esguince, especialmente de tobillo. Ecografía como apoyo cuando está indicada."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Fascitis plantar","description":"Tratamiento de la fascitis plantar con valoración del apoyo, ecografía cuando está indicada y ejercicio para recuperar tolerancia al caminar y correr."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Fisioterapia a domicilio","description":"Valoración, terapia manual y ejercicio terapéutico en casa para dolor musculoesquelético y recuperación de la movilidad."}}]}},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"¿Cuánto dura una sesión?","acceptedAnswer":{"@type":"Answer","text":"La duración puede variar según el caso, pero la primera sesión está planteada como una sesión completa con valoración, tratamiento y pautas. La duración concreta se confirma al reservar."}},{"@type":"Question","name":"¿Atiendes a domicilio?","acceptedAnswer":{"@type":"Answer","text":"Sí. Borja también ofrece fisioterapia a domicilio en Madrid. Confirma tu zona y disponibilidad antes de reservar."}},{"@type":"Question","name":"¿También tienes consulta o gabinete?","acceptedAnswer":{"@type":"Answer","text":"Sí. Borja atiende en el espacio Meraki de la calle de Rafael de Riego, 11, en Arganzuela. También ofrece atención a domicilio en Madrid; confirma disponibilidad antes de reservar."}},{"@type":"Question","name":"¿Qué necesito preparar para la sesión en casa?","acceptedAnswer":{"@type":"Answer","text":"Un espacio tranquilo donde puedas moverte con comodidad. Si hace falta material básico, se confirma antes de la sesión."}},{"@type":"Question","name":"¿Qué tipo de lesiones tratas?","acceptedAnswer":{"@type":"Answer","text":"Dolor cervical y lumbar, lesiones deportivas, tendinopatías, contracturas, esguinces, fascitis plantar y procesos de recuperación funcional."}},{"@type":"Question","name":"¿Cuánto cuesta una sesión?","acceptedAnswer":{"@type":"Answer","text":"La primera sesión en consulta cuesta 50 € y a domicilio 60 €. Confirma disponibilidad y zona de desplazamiento antes de reservar."}},{"@type":"Question","name":"¿Cómo reservo cita?","acceptedAnswer":{"@type":"Answer","text":"La forma más directa es escribir por WhatsApp. También puedes dejar una consulta en el formulario y se revisará tu caso para orientarte."}}]},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Inicio","item":"https://tufisioadomicilio.vercel.app"},{"@type":"ListItem","position":2,"name":"Servicios","item":"https://tufisioadomicilio.vercel.app/#servicios"},{"@type":"ListItem","position":3,"name":"Precio","item":"https://tufisioadomicilio.vercel.app/#precio"},{"@type":"ListItem","position":4,"name":"Contacto","item":"https://tufisioadomicilio.vercel.app/#contacto"}]},{"@context":"https://schema.org","@type":"WebPage","@id":"https://tufisioadomicilio.vercel.app","url":"https://tufisioadomicilio.vercel.app","name":"Fisioterapia en Arganzuela y Madrid | Borja Estarellas Botín","description":"Consulta de fisioterapia en Arganzuela y atención a domicilio en Madrid con Borja Estarellas.","isPartOf":{"@id":"https://tufisioadomicilio.vercel.app"},"about":{"@id":"https://tufisioadomicilio.vercel.app/#organization"},"inLanguage":"es","availableLanguage":"es"}]0:{"P":null,"c":["",""],"q":"","i":false,"f":[[["",{"children":["__PAGE__",{}]},"$undefined","$undefined",16],[["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/0dkf1c43t4~e8.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","script","script-0",{"src":"/_next/static/chunks/0ofe59_hetppt.js","async":true,"nonce":"$undefined"}]],["$","html",null,{"lang":"es","className":"h-full scroll-smooth","children":[["$","head",null,{"children":"$undefined"}],["$","body",null,{"className":"min-h-full bg-[var(--color-off-white)] text-[var(--color-text)] antialiased","children":[["$","$L2",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","main",null,{"className":"premium-dark-bg grid min-h-screen place-items-center px-4 py-20 text-center text-white","children":["$","div",null,{"children":[["$","p",null,{"className":"te